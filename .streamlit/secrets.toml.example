# Copy to .streamlit/secrets.toml for local use, or paste into your host's
# secrets settings (Streamlit Community Cloud: App settings -> Secrets).
# Never commit the real file.

# Read-only MongoDB user (can read the `garmin` database only)
MONGODB_URI = "mongodb+srv://dashboard-reader:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Password viewers type to open the dashboard. Leave out to make it open to anyone with the link.
APP_PASSWORD = "<choose-a-password>"

# Optional: enables Claude in the "Ask your data" tab
ANTHROPIC_API_KEY = "sk-ant-..."
